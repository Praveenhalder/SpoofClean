<?xml version="1.0" encoding="utf-8"?>
<!-- package name comes from namespace/applicationId in app/build.gradle -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">


    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- supportsPictureInPicture: the tile flow parks this activity as a
             mini window over the game - the whitelist engages on a visible
             activity, and PiP keeps one alive without pausing the game.
             configChanges prevents recreation when entering/leaving PiP. -->
        <activity
            android:name="com.antutu.ABenchMark.MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <service
            android:name="com.antutu.ABenchMark.PerformanceService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the benchmark-identity process alive while performance mode is active"/>
        </service>

        <!-- Quick-control (Quick Settings) tile: toggles performance mode.
             BIND_QUICK_SETTINGS_TILE is held by the system, so only the
             system can bind - required declaration on API 33+. -->
        <service
            android:name="com.antutu.ABenchMark.PerformanceTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
        </service>
    </application>
</manifest>
